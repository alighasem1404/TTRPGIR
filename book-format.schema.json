{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttrpgir.local/schemas/book-format.schema.json",
  "title": "TTRPG Book Package",
  "description": "Canonical interchange format for the private Book Maker and the published Book Reader.",
  "type": "object",
  "required": ["format", "schemaVersion", "book", "theme", "entries", "assets"],
  "properties": {
    "format": { "const": "ttrpg-book" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "book": {
      "type": "object",
      "required": ["id", "title", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "language": { "type": "string", "description": "BCP 47 language tag, for example fa-IR." },
        "direction": { "enum": ["ltr", "rtl"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "fileName": { "type": "string" },
        "sourceHash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "conversion": {
      "type": "object",
      "properties": {
        "entryHeadingLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "pageBreaks": { "enum": ["ignore", "preserve-as-metadata"] },
        "imagePolicy": {
          "type": "object",
          "properties": {
            "defaultPlacement": { "enum": ["inline", "asset-only"] },
            "ignoredRoles": { "type": "array", "items": { "type": "string" } },
            "ignorePositioning": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["tokens", "decorations"],
      "properties": {
        "tokens": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "decorations": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src", "alt", "role"],
        "properties": {
          "id": { "type": "string" },
          "src": { "type": "string" },
          "alt": { "type": "string" },
          "role": { "type": "string" },
          "ignored": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "blocks"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/divider" },
        { "$ref": "#/$defs/embed" }
      ]
    },
    "heading": {
      "type": "object",
      "required": ["type", "level", "text"],
      "properties": { "type": { "const": "heading" }, "level": { "type": "integer", "minimum": 1, "maximum": 6 }, "text": { "type": "string" } },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": ["type", "text"],
      "properties": { "type": { "const": "paragraph" }, "text": { "type": "string" }, "style": { "type": "string" } },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["type", "assetId", "role", "placement"],
      "properties": { "type": { "const": "image" }, "assetId": { "type": "string" }, "role": { "type": "string" }, "placement": { "enum": ["inline", "entry-top", "entry-top-right", "section-top", "asset-only"] }, "className": { "type": "string" }, "width": { "type": "string" } },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["type", "items"],
      "properties": { "type": { "const": "list" }, "items": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["type", "columns", "rows"],
      "properties": { "type": { "const": "table" }, "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } },
      "additionalProperties": false
    },
    "divider": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "divider" }, "style": { "type": "string" } },
      "additionalProperties": false
    },
    "embed": {
      "type": "object",
      "required": ["type", "kind"],
      "properties": {
        "type": { "const": "embed" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": { "type": "string" } } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
